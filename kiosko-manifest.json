    }
  ],
  "sources": [
    {
      "type": "news/deck",
      "name": {
        "en": "News deck",
        "es": "Mazo de noticias",
        "zh-Hant": "新聞牌組",
        "zh-Hans": "新闻卡组"
      },
      "description": {
        "en": "Reads the RSS feeds, drops junk and stale items, groups the same story across outlets and orders what to show.",
        "es": "Lee los RSS, quita relleno y noticias viejas, agrupa la misma historia de varias cabeceras y ordena qué enseñar.",
        "zh-Hant": "讀取 RSS 訂閱源，剔除無用和過時的項目，把各家媒體的同一則新聞歸成一組，並排定顯示順序。",
        "zh-Hans": "读取 RSS 订阅源，剔除无用和过时的条目，把各家媒体的同一条新闻归为一组，并排定显示顺序。"
      },
      "polled": true,
      "intervalMs": 600000,
      "options": {
        "default": {
          "feeds": [
            {
              "name": "Xataka IA",
              "url": "https://feeds.weblogssl.com/xataka2",
              "titleFilter": "\\b(?:[Aa]nthropic|[Cc]laude|[Cc]hat[Gg]PT|[Oo]pen[Aa][Ii]|[Gg]emini|[Dd]eep[Mm]ind|[Cc]opilot|[Mm]idjourney|[Dd]eep[Ss]eek|[Mm]istral [Aa][Ii]|[Pp]erplexity|[Ll]lama \\d|[Gg]rok|inteligencia artificial|IA|IAs|AI|LLMs?|chatbots?|modelo de lenguaje|language model|red neuronal|neural network|superinteligencia)\\b",
              "maxAgeMs": 129600000
            },
            {
              "name": "Hipertextual IA",
              "url": "https://hipertextual.com/feed",
              "titleFilter": "\\b(?:[Aa]nthropic|[Cc]laude|[Cc]hat[Gg]PT|[Oo]pen[Aa][Ii]|[Gg]emini|[Dd]eep[Mm]ind|[Cc]opilot|[Mm]idjourney|[Dd]eep[Ss]eek|[Mm]istral [Aa][Ii]|[Pp]erplexity|[Ll]lama \\d|[Gg]rok|inteligencia artificial|IA|IAs|AI|LLMs?|chatbots?|modelo de lenguaje|language model|red neuronal|neural network|superinteligencia)\\b",
              "maxAgeMs": 129600000
            },
            {
              "name": "20minutos IA",
              "url": "https://www.20minutos.es/rss/tecnologia/",
              "titleFilter": "\\b(?:[Aa]nthropic|[Cc]laude|[Cc]hat[Gg]PT|[Oo]pen[Aa][Ii]|[Gg]emini|[Dd]eep[Mm]ind|[Cc]opilot|[Mm]idjourney|[Dd]eep[Ss]eek|[Mm]istral [Aa][Ii]|[Pp]erplexity|[Ll]lama \\d|[Gg]rok|inteligencia artificial|IA|IAs|AI|LLMs?|chatbots?|modelo de lenguaje|language model|red neuronal|neural network|superinteligencia)\\b",
              "maxAgeMs": 129600000
            },
            {
              "name": "Omicrono IA",
              "url": "https://www.elespanol.com/rss/omicrono/",
              "titleFilter": "\\b(?:[Aa]nthropic|[Cc]laude|[Cc]hat[Gg]PT|[Oo]pen[Aa][Ii]|[Gg]emini|[Dd]eep[Mm]ind|[Cc]opilot|[Mm]idjourney|[Dd]eep[Ss]eek|[Mm]istral [Aa][Ii]|[Pp]erplexity|[Ll]lama \\d|[Gg]rok|inteligencia artificial|IA|IAs|AI|LLMs?|chatbots?|modelo de lenguaje|language model|red neuronal|neural network|superinteligencia)\\b",
              "maxAgeMs": 129600000
            },
            {
              "name": "elDiario.es",
              "url": "https://www.eldiario.es/rss/",
              "titleFilter": "",
              "maxAgeMs": 0
            },
            {
              "name": "20minutos",
              "url": "https://www.20minutos.es/rss/",
              "titleFilter": "",
              "maxAgeMs": 0
            },
            {
              "name": "El País",
              "url": "https://feeds.elpais.com/mrss-s/pages/ep/site/elpais.com/portada",
              "titleFilter": "",
              "maxAgeMs": 0
            },
            {
              "name": "La Vanguardia",
              "url": "https://www.lavanguardia.com/rss/home.xml",
              "titleFilter": "",
              "maxAgeMs": 0
            },
            {
              "name": "El Mundo",
              "url": "https://e00-elmundo.uecdn.es/elmundo/rss/portada.xml",
              "titleFilter": "",
              "maxAgeMs": 0
            },
            {
              "name": "ABC",
              "url": "https://www.abc.es/rss/2.0/portada/",
              "titleFilter": "",
              "maxAgeMs": 0
            }
          ],
          "topic": "all",
          "maxAgeMs": 259200000,
          "rejectFilter": "\\b(?:amazon|aliexpress|chollo|descuentazo|superventas|el corte ingl[eé]s|black friday|c[óo]digo promocional|por menos de \\d+ ?(?:euros|€)|merece la pena comprar|he probado (?:el|la|los|las)|comprar[íi]as)\\b|\\b(?:euromillones|primitiva|bonoloto|loter[íi]a|sorteo|hor[óo]scopo|quiniela|cup[óo]n diario|comprobar (?:el|tu)|n[úu]meros premiados)\\b|\\b(?:la joya oculta|joya escondida|lo que nadie|nadie te (?:cuenta|dice)|no te lo vas a creer|te sorprender|vas a alucinar|el truco|este truco|los trucos|la raz[óo]n por la que|el motivo por el que|as[íi] es como|esto es lo que (?:pasa|hace|ocurre)|y no es lo que|el secreto (?:de|que)|dile adi[óo]s|te cambiar[áa] la vida|estas son las claves|las claves para)\\b|\\b(?:en im[áa]genes|en fotos|las mejores fotos|foto a foto|el v[íi]deo viral|se hace viral|arrasa en (?:tiktok|redes)|revoluciona las redes)\\b|\\b(?:en directo|minuto a minuto|s[íi]guelo en vivo|[úu]ltima hora de)\\b|\\b(?:series recomendadas|pel[íi]culas recomendadas|las mejores series|recomendadas para)\\b|^[a-záéíóúñ]+, [a-záéíóúñ ]{3,28}: [\"“']|^(?:las?|los?) \\d+ (?:claves|cosas|razones|trucos|mejores|secretos|motivos)\\b",
          "maxStories": 60
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "feeds": {
            "title": "Feeds",
            "description": "Order matters: a repeated story keeps the label of the first feed.",
            "default": [
              {
                "name": "Xataka IA",
                "url": "https://feeds.weblogssl.com/xataka2",
                "titleFilter": "\\b(?:[Aa]nthropic|[Cc]laude|[Cc]hat[Gg]PT|[Oo]pen[Aa][Ii]|[Gg]emini|[Dd]eep[Mm]ind|[Cc]opilot|[Mm]idjourney|[Dd]eep[Ss]eek|[Mm]istral [Aa][Ii]|[Pp]erplexity|[Ll]lama \\d|[Gg]rok|inteligencia artificial|IA|IAs|AI|LLMs?|chatbots?|modelo de lenguaje|language model|red neuronal|neural network|superinteligencia)\\b",
                "maxAgeMs": 129600000
              },
              {
