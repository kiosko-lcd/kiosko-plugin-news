{
  "name": "kiosko-plugin-news",
  "version": "0.2.1",
  "description": "Press headlines from RSS feeds, no keys and no AI: stories grouped across outlets, a full-bleed photo frame and a news column.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly",
  "keywords": [
    "kiosko",
    "kiosko-plugin",
    "lcd",
    "widgets",
    "info"
  ],
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-news#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko-plugin-news.git"
  },
  "bugs": {
    "url": "https://github.com/kiosko-lcd/kiosko-plugin-news/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "kiosko": {
    "plugin": "./dist/index.js",
    "id": "news"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --conditions=source --test \"src/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@kiosko/sdk": "^0.2.0",
    "@loksly/weather-astro": "^0.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
